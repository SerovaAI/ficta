{
  "name": "@serovaai/ficta",
  "version": "0.7.0",
  "private": false,
  "description": "Keep your registered secrets out of the LLM — local redaction proxy for coding agents",
  "keywords": [
    "ai",
    "coding-agents",
    "llm",
    "privacy",
    "redaction",
    "secrets"
  ],
  "homepage": "https://ficta.sh",
  "bugs": {
    "url": "https://github.com/SerovaAI/ficta/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SerovaAI/ficta.git",
    "directory": "packages/ficta"
  },
  "bin": {
    "ficta": "bin/ficta.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "presidio/",
    "config.toml.example",
    ".env.example"
  ],
  "type": "module",
  "exports": {
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --conditions=development --watch --import tsx src/server.ts",
    "start": "node --conditions=development --import tsx src/server.ts",
    "ficta": "node --conditions=development --import tsx src/cli.ts",
    "build": "tsc",
    "check:presidio": "tsx --conditions=development scripts/verify-presidio-sidecar.mts",
    "prepack": "pnpm --filter \"@serovaai/ficta^...\" run build && pnpm build",
    "format": "oxfmt --write .",
    "lint": "oxlint .",
    "check": "pnpm check:static && pnpm typecheck && pnpm test",
    "check:static": "oxlint . && oxfmt --check .",
    "check:fix": "oxlint --fix . && oxfmt --write .",
    "update": "pnpm up -r -i -L",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "check:live": "pnpm check && pnpm test:e2e",
    "bench": "tsx --conditions=development bench/redaction-bench.mts",
    "bench:entity": "tsx --conditions=development bench/entity-redaction-bench.mts",
    "bench:entity-fidelity": "tsx --conditions=development bench/entity-surrogate-fidelity.mts",
    "check:entity-fidelity-live": "tsx --conditions=development bench/entity-surrogate-fidelity.mts --live-matrix",
    "bench:pii-ner": "tsx --conditions=development bench/pii-ner-benchmark.mts",
    "bench:jev-secret-shapes": "tsx --conditions=development bench/jev-secret-shape-audit.mts",
    "bench:jev-detectors": "tsx --conditions=development bench/jev-detector-benchmark.mts",
    "bench:llm-spans": "tsx --conditions=development bench/llm-span-finder.mts",
    "bench:e2e": "tsx --conditions=development bench/e2e-bench.mts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "@hono/node-server": "^2.1.3",
    "@orpc/openapi": "1.15.4",
    "@orpc/server": "1.15.4",
    "@serovaai/ficta-contract": "workspace:^",
    "@serovaai/ficta-engine": "workspace:^",
    "@serovaai/ficta-protocol": "workspace:^",
    "hono": "^4.13.12",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@typesafe-ai/sdk": "0.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20"
  }
}
