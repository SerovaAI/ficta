{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/react-in-jsx-scope": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": ["**/dist/**", "**/.output/**", "**/.nitro/**", "**/routeTree.gen.ts"]
}
